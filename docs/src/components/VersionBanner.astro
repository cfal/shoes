---
import { docsLabel, sourceRef, sourceRefKnown } from '../../metadata.mjs';
---

<aside class="version-banner" aria-label="Documentation version" data-pagefind-ignore>
  {docsLabel}
  <span aria-hidden="true"> / </span>
  {sourceRefKnown
    ? <a href={`https://github.com/cfal/shoes/commit/${sourceRef}`}>Source {sourceRef.slice(0, 12)}</a>
    : <span>Source revision unavailable</span>}
</aside>

<style>
  .version-banner {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-sidebar);
    color: var(--sl-color-text);
    font-size: 0.875rem;
    text-align: center;
    overflow-wrap: anywhere;
  }
  a { color: var(--sl-color-text-accent); }
</style>
